{
    "name": "rbw-web-pinentry",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "bin": {
        "web-pinentry": "dist-server/src/cli/web-pinentry.js"
    },
    "scripts": {
        "build": "pnpm run build:client && pnpm run build:server",
        "build:client": "vite build",
        "build:server": "tsc -p tsconfig.server.json",
        "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
        "dev": "vite --host 0.0.0.0 --port 3088",
        "dev:server": "NODE_ENV=development DEV_REMOTE_USER=operator PORT=3089 STATIC_DIR=dist-client tsx watch src/server/index.ts",
        "start": "NODE_ENV=production node dist-server/src/server/index.js",
        "cli": "node dist-server/src/cli/web-pinentry.js",
        "test": "pnpm build:server && vitest run",
        "test:integration": "pnpm build:server && vitest run tests/integration/rbw.test.ts",
        "test:watch": "pnpm build:server && vitest",
        "lint": "eslint . && biome lint .",
        "lint:fix": "biome lint --write . && eslint --fix .",
        "format": "biome format --write . && eslint --fix .",
        "format:check": "biome format . && eslint .",
        "check": "biome check . && eslint ."
    },
    "dependencies": {
        "@fastify/static": "^10.1.5",
        "fastify": "^5.12.5"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.15",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@tailwindcss/vite": "^4.3.3",
        "@types/node": "^24.19.1",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.1",
        "eslint": "^10.12.0",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "tailwindcss": "^4.3.3",
        "tsx": "^4.23.15",
        "typescript": "^5.9.0",
        "typescript-eslint": "^8.71.0",
        "vite": "^8.3.2",
        "vitest": "^5.0.3"
    }
}
