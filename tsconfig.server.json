{
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["ES2022"],
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "outDir": "dist-server",
        "rootDir": ".",
        "types": ["node"]
    },
    "include": ["src/server", "src/cli", "src/shared"]
}
